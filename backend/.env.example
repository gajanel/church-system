# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Variables de entorno requeridas para el backend
# Copia este archivo como .env y llena los valores reales.
# NUNCA comitas el archivo .env al repositorio.
# ──────────────────────────────────────────────────────────────────────────────

# URL de conexión a base de datos
# Para desarrollo local con SQLite:
DATABASE_URL=sqlite:///./church.db

# Para producción con PostgreSQL:
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/church_system

# Clave secreta para firmar tokens JWT (mínimo 32 caracteres aleatorios)
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_SEGURA_DE_64_CHARS

# Solo se usa cuando la base no contiene ningun usuario administrador.
# El primer acceso obliga a cambiar esta contrasena.
INITIAL_ADMIN_PASSWORD=CAMBIA_CONTRASENA_ADMINISTRADOR

# Algoritmo de firma JWT
ALGORITHM=HS256

# Tiempo de expiración del access token en minutos (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes permitidos para CORS (separados por coma)
# En producción, poner SOLO el dominio real de tu frontend
# En producción usa exclusivamente HTTPS. En desarrollo puede omitirse.
ALLOWED_ORIGINS=https://sistema.ejemplo.com
ENV=production

# Entorno: development | production
# EN PRODUCCIÓN: cambiar a "production" para deshabilitar Swagger y restringir CORS
ENV=development
