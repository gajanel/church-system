# ============================================================
# church-system.service — Systemd service para producción Linux
# Ubicación: /etc/systemd/system/church-system.service
#
# Activar:
#   sudo systemctl daemon-reload
#   sudo systemctl enable church-system
#   sudo systemctl start church-system
# ============================================================

[Unit]
Description=Church System — FastAPI Backend
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/opt/church-system/backend

# Carga variables del .env real
EnvironmentFile=/opt/church-system/backend/.env

# Gunicorn con workers uvicorn
ExecStart=/opt/church-system/backend/venv/bin/gunicorn \
    -c gunicorn.conf.py \
    main:app

# Reinicio automático ante fallos
Restart=always
RestartSec=5

# Limits de seguridad
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/church-system/backend/static /var/log/church-system

# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=church-system

[Install]
WantedBy=multi-user.target
